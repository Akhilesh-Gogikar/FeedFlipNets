\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Learning-rate sweeps (per-step flips, $\tau =0.05$ unless noted). Shaded bands denote 95\% t-intervals over matched seeds. DFA tracks backprop on MNIST; both methods saturate on the Fashion~MNIST offline subset; and on 20NG the curves are flat, with DFA offering smoother trajectories rather than higher peak accuracy.}}{12}{figure.caption.21}\protected@file@percent }
\newlabel{fig:lrsweep}{{3}{12}{Learning-rate sweeps (per-step flips, $\tau =0.05$ unless noted). Shaded bands denote 95\% t-intervals over matched seeds. DFA tracks backprop on MNIST; both methods saturate on the Fashion~MNIST offline subset; and on 20NG the curves are flat, with DFA offering smoother trajectories rather than higher peak accuracy}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces $\tau $ sweeps: smaller $\tau $ improves accuracy at reduced sparsity; larger $\tau $ enforces zeros and can reduce accuracy in harder tasks across vision, text, and tabular modalities (examples shown for MNIST, Fashion MNIST, 20NG, and California Housing).}}{12}{figure.caption.23}\protected@file@percent }
\newlabel{fig:tausweep}{{4}{12}{$\tau $ sweeps: smaller $\tau $ improves accuracy at reduced sparsity; larger $\tau $ enforces zeros and can reduce accuracy in harder tasks across vision, text, and tabular modalities (examples shown for MNIST, Fashion MNIST, 20NG, and California Housing)}{figure.caption.23}{}}
