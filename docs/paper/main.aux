\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textsc  {AR-DFA}{} in the attention sublayer. Forward (blue) caches $A$, $\mathrm  {Ctx}$, $Q,K,V$. The broadcast error $e_{\text  {attn}}$ (red, dashed) gives the \emph  {exact} $\partial \mathcal  L/\partial W_O=\mathrm  {Ctx}^\top e_{\text  {attn}}$, is routed through the cached data-maps $A,J_A$ exactly, and passes the single forbidden transpose $W_O^\top $ through the surrogate $R_O$ (adapted by \textsc  {PT}). No downstream weight is read.}}{5}{figure.caption.6}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:schematic}{{1}{5}{\ARDFA {} in the attention sublayer. Forward (blue) caches $A$, $\mathrm {Ctx}$, $Q,K,V$. The broadcast error $e_{\text {attn}}$ (red, dashed) gives the \emph {exact} $\partial \mathcal L/\partial W_O=\mathrm {Ctx}^\top e_{\text {attn}}$, is routed through the cached data-maps $A,J_A$ exactly, and passes the single forbidden transpose $W_O^\top $ through the surrogate $R_O$ (adapted by \PT ). No downstream weight is read}{figure.caption.6}{}}
