\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Summary of convergence/stability metrics by run. \textbf  {E@0.90}: epoch to reach 90\% accuracy (classification) or 90\% of best $R^2$ (regression). \textbf  {Slope}: change in metric from epoch~1 to~3. Lower E@0.90 (and E@0.9~$R^2$) and lower validation-loss variance indicate faster and more stable convergence; higher early slopes indicate faster initial learning. Structured feedback often reduces variance without sacrificing speed.}}{21}{table.caption.47}\protected@file@percent }
\newlabel{tab:meta-summary}{{4}{21}{Summary of convergence/stability metrics by run. \textbf {E@0.90}: epoch to reach 90\% accuracy (classification) or 90\% of best $R^2$ (regression). \textbf {Slope}: change in metric from epoch~1 to~3. Lower E@0.90 (and E@0.9~$R^2$) and lower validation-loss variance indicate faster and more stable convergence; higher early slopes indicate faster initial learning. Structured feedback often reduces variance without sacrificing speed}{table.caption.47}{}}
