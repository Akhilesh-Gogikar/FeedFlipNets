\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Alignment ($\rho $, mean across layers) over epochs for selected DFA variants. Each trace is averaged over matched seeds ($n=3$, mean $\pm $ 95\% t-interval); schedule indicated in the legend (per-step vs.\ per-epoch) with $\tau =0.05$ unless noted. Metric definitions appear in Table~\ref {tab:metrics-key}.}}{16}{figure.caption.29}\protected@file@percent }
\newlabel{fig:rho-curves}{{7}{16}{Alignment ($\rho $, mean across layers) over epochs for selected DFA variants. Each trace is averaged over matched seeds ($n=3$, mean $\pm $ 95\% t-interval); schedule indicated in the legend (per-step vs.\ per-epoch) with $\tau =0.05$ unless noted. Metric definitions appear in Table~\ref {tab:metrics-key}}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Bound calibration on AG News per-step ternary runs. Each point is a per-epoch proxy aggregated over matched seeds ($n=3$, mean $\pm $ 95\% t-interval); schedule=per-step, $\tau =0.05$. The dashed line is $y=x$. Logged estimates of $\hat  p$, $\hat  {\sigma }_q^2$, and $1-\bar  \rho $ predict the observed $\lVert \nabla L\rVert ^2$ within a median relative gap of $\approx 18\%$, connecting the plot to the time-averaged bound in Eq.~(\ref {eq:stationarity-gap}).}}{16}{figure.caption.30}\protected@file@percent }
\newlabel{fig:bound-calibration}{{8}{16}{Bound calibration on AG News per-step ternary runs. Each point is a per-epoch proxy aggregated over matched seeds ($n=3$, mean $\pm $ 95\% t-interval); schedule=per-step, $\tau =0.05$. The dashed line is $y=x$. Logged estimates of $\hat p$, $\hat {\sigma }_q^2$, and $1-\bar \rho $ predict the observed $\lVert \nabla L\rVert ^2$ within a median relative gap of $\approx 18\%$, connecting the plot to the time-averaged bound in Eq.~(\ref {eq:stationarity-gap})}{figure.caption.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Early learning dynamics: accuracy slope from epochs~1--3 (higher is better). Bars report mean $\pm $ 95\% t-intervals over matched seeds ($n=3$ unless noted) with schedule and $\tau $ specified in the legend (per-step, $\tau =0.05$ unless noted). Metric definitions appear in Table~\ref {tab:metrics-key}.}}{17}{figure.caption.31}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Meta-summary.}{17}{section*.32}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Summary of convergence and stability diagnostics. \textbf  {E@90\% of best}: epoch where the run first attains 90\% of its own best validation score (accuracy or $R^2$). \textbf  {Slope}: change in metric from epoch~1 to~3. Lower E@90\% of best and lower stability CVs indicate faster, steadier convergence; higher early slopes indicate faster initial learning.\newline  \footnotesize  Val.\ Var: variance of validation loss across epochs per run, averaged over matched seeds.}}{17}{table.caption.33}\protected@file@percent }
\newlabel{tab:meta-summary}{{4}{17}{Summary of convergence and stability diagnostics. \textbf {E@90\% of best}: epoch where the run first attains 90\% of its own best validation score (accuracy or $R^2$). \textbf {Slope}: change in metric from epoch~1 to~3. Lower E@90\% of best and lower stability CVs indicate faster, steadier convergence; higher early slopes indicate faster initial learning.\newline \footnotesize Val.\ Var: variance of validation loss across epochs per run, averaged over matched seeds}{table.caption.33}{}}
