\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces FeedFlipNets schematic. Forward (blue) exposes Ter. $W=Q_\tau (V)$, while DFA feedback (red, dashed) broadcasts output error directly to hidden layers via fixed $B_\ell $ (no weight symmetry). Float shadow weights $V$ are optimized and periodically flipped into $W$. Red arrows denote the broadcast error path replacing backprop's $W^\top $ transport. Legend: blue solid arrows -- forward path; red dashed arrows -- broadcast error via $B_\ell $.}}{8}{figure.caption.11}\protected@file@percent }
